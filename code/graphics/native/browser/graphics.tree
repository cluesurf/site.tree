
# Browser graphics impl: delegates to WebGL2 through @cluesurf/bind. Conforms to the abstract API in ../graphics. The
# surface handle is opaque (an erased WebGL2 context), so each task re-types it to the bind context form and calls the
# method with member syntax (`call gl/clear`). bind's methods are JS-`this`-style, so the receiver is the member
# target and the args are the method's params; the emitter lowers `gl.clear(...)`. Constants are `link` fields on the
# context (`read gl/color-buffer-bit` lowers to `gl.COLOR_BUFFER_BIT`). This slice covers open / size / clear; shaders,
# buffers, and draw follow.

load ../../../dom/native/global
  find page

load @cluesurf/bind/code/browser/dom/web-gl2-rendering-context
  find web-gl2-rendering-context

load ../../surface
  find surface
  find shader
  find program
  find gpu-buffer
  find shader-kind

# Acquire the canvas by id and its WebGL2 context. The context is stored opaque in the surface handle.
task open
  take id, like text
  like surface
  host canvas
    call page/get-element-by-id
      read id
  host made
    call canvas/get-context
      text <webgl2>
  send back
    make surface
      bind handle, read made

# Set the drawing buffer viewport.
task size
  take pane, like surface
  take width, like u32
  take height, like u32
  host gl, like web-gl2-rendering-context
    read pane/handle
  call gl/viewport
    mark 0
    mark 0
    read width
    read height

# Clear the surface to a color, each channel 0..1.
task clear
  take pane, like surface
  take red, like f64
  take green, like f64
  take blue, like f64
  take alpha, like f64
  host gl, like web-gl2-rendering-context
    read pane/handle
  call gl/clear-color
    read red
    read green
    read blue
    read alpha
  call gl/clear
    read gl/color-buffer-bit

# Compile a shader for the given GL stage constant. Private: make-shader maps the kind union to the constant.
task make-stage
  mark private
  take gl, like web-gl2-rendering-context
  take type-code
  take source, like text
  like shader
  host made
    call gl/create-shader
      read type-code
  call gl/shader-source
    read made
    read source
  call gl/compile-shader
    read made
  send back
    make shader
      bind handle, read made

# Compile one shader stage from its source.
task make-shader
  take pane, like surface
  take kind, like shader-kind
  take source, like text
  like shader
  host gl, like web-gl2-rendering-context
    read pane/handle
  fork case, read kind
    case vertex
      send back
        call make-stage
          read gl
          read gl/vertex-shader
          read source
    case fragment
      send back
        call make-stage
          read gl
          read gl/fragment-shader
          read source

# Link a vertex and fragment shader into a draw program.
task make-program
  take pane, like surface
  take vertex, like shader
  take fragment, like shader
  like program
  host gl, like web-gl2-rendering-context
    read pane/handle
  host made
    call gl/create-program
  call gl/attach-shader
    read made
    read vertex/handle
  call gl/attach-shader
    read made
    read fragment/handle
  call gl/link-program
    read made
  send back
    make program
      bind handle, read made

# Upload vertex data to a buffer.
task make-buffer
  take pane, like surface
  take data, like list
  like gpu-buffer
  host gl, like web-gl2-rendering-context
    read pane/handle
  host made
    call gl/create-buffer
  call gl/bind-buffer
    read gl/array-buffer
    read made
  call gl/buffer-data
    read gl/array-buffer
    read data
    read gl/static-draw
  send back
    make gpu-buffer
      bind handle, read made

# Draw `count` vertices from the buffer with the program. Attribute 0 is two floats per vertex.
task draw
  take pane, like surface
  take prog, like program
  take verts, like gpu-buffer
  take count, like u32
  host gl, like web-gl2-rendering-context
    read pane/handle
  call gl/use-program
    read prog/handle
  call gl/bind-buffer
    read gl/array-buffer
    read verts/handle
  call gl/enable-vertex-attrib-array
    mark 0
  call gl/vertex-attrib-pointer
    mark 0
    mark 2
    read gl/float
    wave false
    mark 0
    mark 0
  call gl/draw-arrays
    read gl/triangles
    mark 0
    read count
