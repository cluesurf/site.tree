
# DOM: the host-tree abstraction the render runtime targets. The platform-agnostic public API; native impls under
# native/ wrap the real browser DOM or an in-memory tree (server / headless), delegated via dock. The render runtime
# never touches a host primitive directly, only this API, so it is identical on every backend.

form view
  link handle, mark private

task create-element
  take tag, like text
  like view

task create-text
  take value, like text
  like view

task set-text
  take node, like view
  take value, like text

task set-attribute
  take node, like view
  take name, like text
  take value, like text

task get-attribute
  take node, like view
  take name, like text
  like text

task set-style
  take node, like view
  take property, like text
  take value, like text

task add-class
  take node, like view
  take name, like text

task remove-class
  take node, like view
  take name, like text

task set-property
  take node, like view
  take name, like text
  take value, like text

task listen
  take node, like view
  take event, like text
  take handler
    like task

task append
  take parent, like view
  take child, like view

task remove
  take node, like view

task replace
  take old, like view
  take new, like view

task child-count
  take node, like view
  like number
